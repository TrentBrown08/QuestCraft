# QuestCraft 26.3 release settings, read by release.sh
# Only GITHUB_OWNER has to be changed.

# your GitHub username (or org) that hosts the fork + release
GITHUB_OWNER=TrentBrown08

# fork of Pojlib that serves mods.json / supportedVersions.json, and the branch to read them from
DATA_REPO=Pojlib
DATA_BRANCH=QuestCraft-6.0.0

# repo + tag of the GitHub release that holds JRE-25.zip and the Vivecraft jar
RELEASE_REPO=QuestCraft
RELEASE_TAG=26.3-1
